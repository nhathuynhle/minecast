# Public build-time configuration (same network as the deployed contract)
VITE_TOKENCAST_CONTRACT_ADDRESS=0xYourDeployedTokenCastAddress
VITE_TOKENCAST_CHAIN_ID=8453

# Vercel server-only configuration. Do not expose these with a VITE_ prefix.
TOKENCAST_CONTRACT_ADDRESS=0xYourDeployedTokenCastAddress
TOKENCAST_CHAIN_ID=8453
SIGNER_PRIVATE_KEY=0x...
# Dedicated Base RPC used by the server to read the claim nonce and era.
BASE_RPC_URL=https://sepolia.base.org
# Server-side verified mining ledger in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
# Farcaster Quick Auth and cast verification.
FARCASTER_AUTH_AUDIENCE=minecast-beta.vercel.app
NEYNAR_API_KEY=your-neynar-api-key
