# Public build-time configuration (same network as the deployed contract)
VITE_TOKENCAST_CONTRACT_ADDRESS=0xYourDeployedTokenCastAddress
VITE_TOKENCAST_CHAIN_ID=8453

# Vercel server-only configuration. Do not expose these with a VITE_ prefix.
TOKENCAST_CONTRACT_ADDRESS=0xYourDeployedTokenCastAddress
TOKENCAST_CHAIN_ID=8453
SIGNER_PRIVATE_KEY=0x...
# Optional dedicated Base RPC for reliable nonce verification in the Vercel function.
BASE_RPC_URL=https://mainnet.base.org
# Internal endpoint that authenticates the Farcaster user and returns their verified,
# unclaimed allocation as { amount, nonce }. The browser must never set this amount.
CLAIM_LEDGER_URL=https://your-ledger.example.com/internal/claim-allocation
CLAIM_LEDGER_SECRET=replace-with-a-long-random-secret
