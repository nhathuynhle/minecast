# Public build-time configuration (same network as the deployed contract)
# Keep legacy until the separate V4 deployment and session migration are ready.
VITE_MINING_PROTOCOL=legacy
VITE_TOKENCAST_CONTRACT_ADDRESS=0xYourDeployedTokenCastAddress
VITE_TOKENCAST_CHAIN_ID=8453

# Vercel server-only configuration. Do not expose these with a VITE_ prefix.
TOKENCAST_CONTRACT_ADDRESS=0xYourDeployedTokenCastAddress
TOKENCAST_CHAIN_ID=8453
# Exactly 32 bytes: 0x + 64 hex characters. This is NOT the signer address.
SIGNER_PRIVATE_KEY=0x...
# Dedicated Base RPC used by the server to read the claim nonce and era.
BASE_RPC_URL=https://sepolia.base.org
# Server-side verified mining ledger in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
# Farcaster Quick Auth and cast verification.
FARCASTER_AUTH_AUDIENCE=minecast-beta.vercel.app
NEYNAR_API_KEY=your-neynar-api-key

# Open V4: use all five addresses from the verified V4 deployment, never V2/V3.
# Set VITE_MINING_PROTOCOL=v4 only after these are configured.
VITE_V4_CHAIN_ID=84532
VITE_V4_TOKEN_ADDRESS=
VITE_V4_DISTRIBUTOR_ADDRESS=
VITE_V4_STAKING_ADDRESS=
VITE_V4_DAO_ADDRESS=
VITE_V4_REGISTRY_ADDRESS=
# Optional browser-visible RPC. Do not put a private billing key here.
VITE_V4_RPC_URL=

# V4 session intake (server only). This service has no mining mint/signing key.
V4_CHAIN_ID=84532
V4_TOKEN_ADDRESS=
V4_DISTRIBUTOR_ADDRESS=
V4_STAKING_ADDRESS=
V4_DAO_ADDRESS=
V4_REGISTRY_ADDRESS=
V4_RPC_URL=
